#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for python_command in "$repo_dir/.venv/bin/python" python3.11 python3 python3.14 python3.13 python3.12; do
    if "$python_command" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$python_command" "$repo_dir/scripts/bootstrap.py" "$@"
    fi
done
echo "DIY Cancer Vaccine requires Python 3.11 or newer. Install Python, then run ./run again." >&2
exit 1
